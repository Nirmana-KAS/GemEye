# Auto-detect text files and normalise line endings to LF
* text=auto eol=lf

# Force specific file types
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.xml text eol=lf

# Binary files — do not touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.otf binary
*.tflite binary
*.pkl binary
*.json filter=lfs diff=lfs merge=lfs -text
